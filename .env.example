APP_ENV=development
GIN_MODE=release
PORT=8080
SERVER_PORT=8086
CONFIG_SERVICE_URL=
DB_AUTO_MIGRATE=false

# CORS para frontends locales
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

API_GATEWAY_PORT=8081
API_GATEWAY_BASE_URL_LOCAL=http://localhost:8081

# Sensibles (usar valores reales locales)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Fallback local opcional si Config Service no responde
API_BASE_PATH=/api/v1
STRIPE_CURRENCY=pen
# false para ejecutar desde GoLand/host con Kafka externo o compartido.
# true solo si quieres forzar la creacion/verificacion administrativa de topicos.
KAFKA_ENSURE_TOPICS=false
KAFKA_BROKERS=<eventhubs-namespace>.servicebus.windows.net:9093
KAFKA_CLIENT_ID=payments-service
KAFKA_CONSUMER_GROUP=payments-service-group
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=$ConnectionString
KAFKA_PASSWORD=Endpoint=sb://<eventhubs-namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
KAFKA_TOPIC_PAYMENTS_EVENTS=payments.events
KAFKA_TOPIC_BILLING_EVENTS=billing.events
KAFKA_TOPIC_SUBSCRIPTIONS_EVENTS=subscriptions.events
