APP_ENV=development
GIN_MODE=release
PORT=8080
SERVER_PORT=8086
CONFIG_SERVICE_URL=
DB_AUTO_MIGRATE=false

# CORS para frontends locales
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

API_GATEWAY_PORT=8081
API_GATEWAY_BASE_URL_LOCAL=http://localhost:8081

# Sensibles (usar valores reales locales)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Fallback local opcional si Config Service no responde
API_BASE_PATH=/api/v1
STRIPE_CURRENCY=pen
# false para ejecutar desde GoLand/host con Kafka externo o compartido.
# true solo si quieres forzar la creacion/verificacion administrativa de topicos.
KAFKA_ENSURE_TOPICS=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payments-service
KAFKA_TOPIC_PAYMENT_PROCESSED=payment.processed
KAFKA_TOPIC_PAYMENT_FAILED=payment.failed
KAFKA_TOPIC_INVOICE_GENERATED=invoice.generated
KAFKA_TOPIC_PAYMENT_METHOD_ADDED=payment.method.added
KAFKA_TOPIC_SUBSCRIPTION_CREATED=subscription.created
KAFKA_TOPIC_SUBSCRIPTION_RENEWAL_REQUESTED=subscription.renewal.requested
KAFKA_TOPIC_SUBSCRIPTION_CANCELLED=subscription.cancelled
